# Settings for the lab vLLM server on tassan. Sourced by setup_vllm.sh, serve_vllm.sh, status.sh.
# Everything lives under LLMBENCH; nothing is installed system-wide.

LLMBENCH=${LLMBENCH:-$HOME/llm-bench}

# Model (Hugging Face repo) and the short name clients ask for (no "/" so Claude Code accepts it).
# Default: Qwen3-Coder-Next 80B-A3B in NVFP4 (~45 GB), leaves ~40 GB of card 0 for users' context.
MODEL=RedHatAI/Qwen3-Coder-Next-NVFP4
SERVED_NAME=qwen3-coder-next
TOOL_PARSER=qwen3_coder
# Alternatives (change the three lines above together):
#   MODEL=unsloth/Qwen3-Coder-Next-FP8-Dynamic   SERVED_NAME=qwen3-coder-next   TOOL_PARSER=qwen3_coder
#     ~80 GB, near-lossless, little room left for concurrent users: lower MAX_MODEL_LEN / MAX_NUM_SEQS
#   MODEL=Qwen/Qwen3.6-35B-A3B   SERVED_NAME=qwen3.6-35b   TOOL_PARSER=qwen3_coder
#     thinking model: also set EXTRA_ARGS="--reasoning-parser qwen3"

# Pin to one card so the other one stays free for the lab.
GPU=0
PORT=8000                      # bound to 127.0.0.1 only, reached through SSH tunnels
GPU_UTIL=0.90                  # fraction of the card vLLM may take (weights + KV cache)
MAX_MODEL_LEN=131072           # max context per request
MAX_NUM_SEQS=16                # max requests decoded together
EXTRA_ARGS=""

# Leave empty to take the latest release; pin (e.g. 0.30.0) once a version is known to work.
VLLM_VERSION=""

export HF_HOME=$LLMBENCH/hf

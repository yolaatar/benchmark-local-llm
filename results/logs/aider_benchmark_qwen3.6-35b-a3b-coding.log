Let's assemble the final `sgf_parsing.py`.

```python
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string[0] != '(':
        raise ValueError("tree missing")
    
    idx = 0
    n = len(input_string)
    
    def parse_tree():
        nonlocal idx
        if idx >= n or input_string[idx] != '(':
            raise ValueError("tree missing")
        idx += 1
        
        if idx < n and input_string[idx] == ')':
            raise ValueError("tree with no nodes")
            
        if idx >= n or input_string[idx] != ';':
            raise ValueError("tree missing")
            
        node = parse_node()
        
        children = []
        while idx < n and input_string[idx] != ')':
            if input_string[idx] == ';':
                children.append(parse_node())
            elif input_string[idx] == '(':
                children.append(parse_tree())
            else:
                raise ValueError("tree missing")
                
        if idx < n and input_string[idx] == ')':
            idx += 1
            
        return SgfTree(properties=node['properties'], children=children)

    def parse_node():
        nonlocal idx
        if idx < n and input_string[idx] == ';':
            idx += 1
        else:
            raise ValueError("tree missing")
            
        props = {}
        while idx < n and input_string[idx] != ';' and input_string[idx] != 
')':
            key = ""
            while idx < n and input_string[idx].isupper():
                key += input_string[idx]
                idx += 1
            if not key:
                raise ValueError("property must be in uppercase")
            if idx >= n or input_string[idx] != '[':
                raise ValueError("properties without delimiter")
            idx += 1 # consume '['
            
            values = []
            while idx < n and input_string[idx] != ']':
                c = input_string[idx]
                if c == '\\':
                    idx += 1
                    if idx < n:
                        nc = input_string[idx]
                        if nc == '\n':
                            pass
                        elif nc.isspace():
                            c = ' '
                        else:
                            c = nc
                        idx += 1
                    else:
                        raise ValueError("properties without delimiter")
                else:
                    if c.isspace():
                        c = ' '
                values.append(c)
                idx += 1
                
            if idx >= n or input_string[idx] != ']':
                raise ValueError("properties without delimiter")
            idx += 1 # consume ']'
            
            props[key] = values
            
        return {'properties': props}

    tree = parse_tree()
    
    if idx < n:
        raise ValueError("tree missing")
        
    return tree
```


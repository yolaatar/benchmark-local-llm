```python
class BowlingGame:
    def __init__(self):
        self.rolls = []
        self.current_frame = 0
        self.current_throw = 0

    def roll(self, pins):
        if pins < 0:
            raise ValueError("Negative roll is invalid")
        if pins > 10:
            raise ValueError("Pin count exceeds pins on the lane")
            
        if self.is_game_over():
            raise ValueError("Cannot roll after game is over")
            
        if self.current_frame < 9:
            if self.current_throw == 1:
                if self.rolls[-1] + pins > 10:
                    raise ValueError("Pin count exceeds pins on the lane")
        else:
            # 10th frame

```python
def answer(question):
    if not question.startswith("What is "):
        raise ValueError("unknown operation")
    if not question.endswith("?"):
        raise ValueError("syntax error")
        
    expr = question[8:-1].strip()
    if not expr:
        raise ValueError("syntax error")
        
    tokens = expr.split()
    result = None
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token.lstrip('-').isdigit():
            num = int(token)
            if result is None:
                result = num
            else:
                raise ValueError("syntax error")
            i += 1
        elif token == "plus":
            if result is None or i + 1 >= len(tokens) or not 
tokens[i+1].lstrip('-').isdigit():
                raise ValueError("syntax error")
            result += int(tokens[i+1])
            i += 2
        elif token == "minus":
            if result is None or i + 1 >= len(tokens) or not 
tokens[i+1].lstrip('-').isdigit():
                raise ValueError("syntax error")
            result -= int(tokens[i+1])
            i += 2
        elif token == "multiplied":
            if result is None or i + 1 >= len(tokens) or tokens[i+1] != "by":
                raise ValueError("syntax error")
            if i + 2 >= len(tokens) or not tokens[i+2].lstrip('-').isdigit():
                raise ValueError("syntax error")
            result *= int(tokens[i+2])
            i += 3
        elif token == "divided":
            if result is None or i + 1 >= len(tokens) or tokens[i+1] != "by":
                raise ValueError("syntax error")
            if i + 2 >= len(tokens) or not tokens[i+2].lstrip('-').isdigit():
                raise ValueError("syntax error")
            result //= int(tokens[i+2])
            i += 3
        else:
            raise ValueError("unknown operation")
            
    if result is None:
        raise ValueError("syntax error")
        
    return result
```


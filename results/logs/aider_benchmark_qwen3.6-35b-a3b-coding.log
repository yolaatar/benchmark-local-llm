                        idx += 1
                    else:
                        raise ValueError("properties without delimiter")
                else:
                    if c.isspace():
                        c = ' '
                values.append(c)
                idx += 1
                
            if idx >= n or input_string[idx] != ']':
                raise ValueError("properties without delimiter")
            idx += 1 # consume ']'
            
            props[key] = values
            
        return {'properties': props}

    tree = parse_tree()
    
    if idx < n:
        raise ValueError("tree missing")
        
    return tree

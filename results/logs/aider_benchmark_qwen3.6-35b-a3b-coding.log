```python
import json

class RestAPI:
    def __init__(self, database=None):
        self.users = {}
        if database:
            if isinstance(database, str):
                data = json.loads(database)
            else:
                data = database
            for user_data in data.get("users", []):
                name = user_data["name"]
                self.users[name] = {
                    "name": name,
                    "owes": dict(user_data.get("owes", {})),
                    "owed_by": dict(user_data.get("owed_by", {})),
                    "balance": user_data.get("balance", 0.0)
                }

    def _format_user(self, user):
        return {
            "name": user["name"],
            "owes": dict(user["owes"]),
            "owed_by": dict(user["owed_by"]),
            "balance": sum(user["owed_by"].values()) - 
sum(user["owes"].values())
        }

    def get(self, url, payload=None):
        if url == "/users":
            data = json.loads(payload) if isinstance(payload, str) else payload
            if data and "users" in data:
                requested = data["users"]
                result = [self._format_user(self.users[name]) for name in 
requested if name in self.users]
            else:
                result = [self._format_user(u) for u in self.users.values()]
            result.sort(key=lambda x: x["name"])
            return {"users": result}
        return None

    def post(self, url, payload=None):
        if url == "/add":
            data = json.loads(payload) if isinstance(payload, str) else payload
            name = data["user"]
            if name not in self.users:
                self.users[name] = {"name": name, "owes": {}, "owed_by": {}, 
"balance": 0}
            return {"user": self._format_user(self.users[name])}
        elif url == "/iou":
            data = json.loads(payload) if isinstance(payload, str) else payload
            lender = data["lender"]
            borrower = data["borrower"]
            amount = data["amount"]
            
            if lender not in self.users:
                self.users[lender] = {"name": lender, "owes": {}, "owed_by": 
{}, "balance": 0}
            if borrower not in self.users:
                self.users[borrower] = {"name": borrower, "owes": {}, 
"owed_by": {}, "balance": 0}
                
            lender_user = self.users[lender]
            borrower_user = self.users[borrower]
            
            # Record the new debt
            borrower_user["owes"][lender] = borrower_user["owes"].get(lender, 
0) + amount
            lender_user["owed_by"][borrower] = 
lender_user["owed_by"].get(borrower, 0) + amount
            
            # Net out debts between them
            if lender in borrower_user["owes"] and borrower in 
lender_user["owed_by"]:
                min_val = min(borrower_user["owes"][lender], 
lender_user["owed_by"][borrower])
                borrower_user["owes"][lender] -= min_val
                lender_user["owed_by"][borrower] -= min_val
                if borrower_user["owes"][lender] == 0:
                    del borrower_user["owes"][lender]
                if lender_user["owed_by"][borrower] == 0:
                    del lender_user["owed_by"][borrower]
                    
            return {"users": [self._format_user(self.users[lender]), 
self._format_user(self.users[borrower])]}
        return None
```


    price = sum(PRICES[g] for g in groups)
    
    # Optimization: replace 5+3 with 4+4
    num_5 = groups.count(5)
    num_3 = groups.count(3)
    replacements = min(num_5, num_3)
    price -= replacements * 0.40
    
    return price
```


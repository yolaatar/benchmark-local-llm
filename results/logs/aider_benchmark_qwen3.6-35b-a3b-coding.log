    result = []
    for num in numbers:
        if num == 0:
            result.append(0)
            continue
        
        chunks = []
        while num > 0:
            chunks.append(num & 0x7F)
            num >>= 7
            
        # chunks are in reverse order (LSB first)
        # We need to output them MSB first, with continuation bit set on all 
but the last
        for i in range(len(chunks) - 1, -1, -1):
            byte = chunks[i]
            if i > 0:

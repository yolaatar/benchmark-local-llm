import json

class RestAPI:
    def __init__(self, database=None):
        self.users = {}
        if database:
            if isinstance(database, str):
                data = json.loads(database)
            else:
                data = database
            for user_data in data.get("users", []):
                name = user_data["name"]
                self.users[name] = {
                    "name": name,
                    "owes": dict(user_data.get("owes", {})),
                    "owed_by": dict(user_data.get("owed_by", {})),
                    "balance": user_data.get("balance", 0.0)
                }

    def _format_user(self, user):
        return {
            "name": user["name"],
            "owes": dict(user["owes"]),
            "owed_by": dict(user["owed_by"]),
            "balance": sum(user["owed_by"].values()) - 
sum(user["owes"].values())
        }

    def get(self, url, payload=None):
        if url == "/users":
            data = json.loads(payload) if isinstance(payload, str) else 
(payload or {})
            if data and "users" in data:
                requested = data["users"]
                result = [self._format_user(self.users[name]) for name in 
requested if name in self.users]
            else:
                result = [self._format_user(u) for u in self.users.values()]
            result.sort(key=lambda x: x["name"])
            return {"users": result}
        return None

    def post(self, url, payload=None):
        if url == "/add":
            data = json.loads(payload) if isinstance(payload, str) else 
(payload or {})

```python
def transpose(text):
    if not text:
        return ""
    
    lines = text.split('\n')
    max_len = max(len(line) for line in lines)
    
    result = []
    for j in range(max_len):
        # Find the last row that has a character at column j
        last_row = -1
        for i in range(len(lines) - 1, -1, -1):
            if j < len(lines[i]):
                last_row = i
                break
        
        if last_row == -1:
            continue
            
        new_row = []
        for i in range(last_row + 1):
            if j < len(lines[i]):
                new_row.append(lines[i][j])
            else:
                new_row.append(' ')
        result.append("".join(new_row))
        
    return "\n".join(result)
```


```python
def total(basket):
    if not basket:
        return 0
        
    counts = {}
    for book in basket:
        counts[book] = counts.get(book, 0) + 1
        
    PRICES = {1: 800, 2: 1520, 3: 2160, 4: 2560, 5: 3000}
    
    def min_price(counts_tuple):
        if not counts_tuple:
            return 0
        if counts_tuple in min_price.cache:
            return min_price.cache[counts_tuple]
            
        max_group = max(counts_tuple)
        res = float('inf')
        for size in range(1, max_group + 1):
            # form a group of 'size'
            new_counts = []
            valid = True
            for c in counts_tuple:
                if c > 0:
                    new_counts.append(c - 1)
                else:
                    valid = False
                    break
            if valid:
                res = min(res, PRICES[size] + min_price(tuple(new_counts)))
                
        min_price.cache[counts_tuple] = res
        return res
        
    min_price.cache = {}

Let's assemble the code.

```python
def recite(start_verse, end_verse):
    animals = [
        "fly", "spider", "bird", "cat", "dog", "goat", "cow", "horse"
    ]
    second_lines = {
        "spider": "It wriggled and jiggled and tickled inside her.",
        "bird": "How absurd to swallow a bird!",
        "cat": "Imagine that, to swallow a cat!",
        "dog": "What a hog, to swallow a dog!",
        "goat": "Just opened her throat and swallowed a goat!",
        "cow": "I don't know how she swallowed a cow!",
        "horse": "She's dead, of course!"
    }
    
    result = []
    for v in range(start_verse, end_verse + 1):
        idx = v - 1
        verse = [f"I know an old lady who swallowed a {animals[idx]}."]
        
        if v == 8:
            verse.append("She's dead, of course!")
        elif v == 1:
            verse.append("I don't know why she swallowed the fly. Perhaps 
she'll die.")
        else:
            verse.append(second_lines[animals[idx]])
            for i in range(idx, 0, -1):
                current = animals[i]
                prev = animals[i-1]
                line = f"She swallowed the {current} to catch the {prev}"
                if prev == "spider":
                    line += " that wriggled and jiggled and tickled inside 
her."
                verse.append(line)
            verse.append("I don't know why she swallowed the fly. Perhaps 
she'll die.")
            
        result.extend(verse)
        if v < end_verse:

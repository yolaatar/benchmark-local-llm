class InputCell:
    def __init__(self, initial_value):
        self._value = initial_value
        self._dependents = []

    @property
    def value(self):
        return self._value

    @value.setter
    def value(self, new_value):
        if self._value == new_value:
            return
        self._value = new_value
        self._notify_dependents()

    def _notify_dependents(self):
        affected = set()
        queue = list(self._dependents)
        while queue:
            cell = queue.pop(0)
            if cell not in affected:
                affected.add(cell)
                queue.extend(cell._dependents)
        
        old_values = {cell: cell.value for cell in affected}
        
        changed = True
        while changed:
            changed = False
            for cell in affected:
                new_val = cell._compute()
                if new_val != cell.value:
                    cell._value = new_val
                    changed = True
        
        for cell in affected:
            if old_values[cell] != cell.value:
                for cb in list(cell._callbacks):
                    cb(cell.value)



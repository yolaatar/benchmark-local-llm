```python
from collections import Counter

def best_hands(hands):
    def evaluate(hand):
        cards = hand.split()
        ranks = []
        suits = []
        for card in cards:
            rank_str = card[:-1]
            suit = card[-1]
            suits.append(suit)
            if rank_str == 'A':
                ranks.append(14)
            elif rank_str == 'K':
                ranks.append(13)
            elif rank_str == 'Q':
                ranks.append(12)
            elif rank_str == 'J':
                ranks.append(11)
            elif rank_str == 'T':
                ranks.append(10)
            else:
                ranks.append(int(rank_str))
                
        is_flush = len(set(suits)) == 1
        sorted_ranks = sorted(ranks, reverse=True)
        
        is_straight = False
        straight_high = 0
        if sorted_ranks == [14, 13, 12, 11, 10]:
            is_straight = True
            straight_high = 14
        elif sorted_ranks == [14, 5, 4, 3, 2]:
            is_straight = True
            straight_high = 5
        elif sorted_ranks[0] - sorted_ranks[4] == 4 and len(set(sorted_ranks)) 
== 5:
            is_straight = True
            straight_high = sorted_ranks[0]
            
        rank_counts = Counter(ranks)
        counts = sorted(rank_counts.values(), reverse=True)
        
        sorted_ranks_by_freq = sorted(ranks, key=lambda r: (-rank_counts[r], 
-r))
        
        if is_flush and is_straight:
            return (8, straight_high)
        elif counts[0] == 4:
            return (7, sorted_ranks_by_freq[0], sorted_ranks_by_freq[3], 
sorted_ranks_by_freq[4])
        elif counts[0] == 3 and counts[1] == 2:
            return (6, sorted_ranks_by_freq[0], sorted_ranks_by_freq[3])
        elif is_flush:
            return (5, sorted_ranks[0], sorted_ranks[1], sorted_ranks[2], 
sorted_ranks[3], sorted_ranks[4])
        elif is_straight:
            return (4, straight_high)
        elif counts[0] == 3:
            return (3, sorted_ranks_by_freq[0], sorted_ranks_by_freq[3], 
sorted_ranks_by_freq[4])
        elif counts[0] == 2 and counts[1] == 2:
            return (2, sorted_ranks_by_freq[0], sorted_ranks_by_freq[1], 
sorted_ranks_by_freq[4])
        elif counts[0] == 2:
            return (1, sorted_ranks_by_freq[0], sorted_ranks_by_freq[2], 
sorted_ranks_by_freq[3], sorted_ranks_by_freq[4])
        else:
            return (0, sorted_ranks[0], sorted_ranks[1], sorted_ranks[2], 
sorted_ranks[3], sorted_ranks[4])

    evaluated = [(evaluate(h), h) for h in hands]
    max_eval = max(e[0] for e in evaluated)
    return [h for e, h in evaluated if e[0] == max_eval]
```


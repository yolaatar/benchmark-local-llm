```python
def evaluate(hand):
    cards = hand.split()
    ranks = []
    suits = []
    for card in cards:
        rank_str = card[:-1]
        suit = card[-1]
        suits.append(suit)
        if rank_str == 'A':
            ranks.append(14)
        elif rank_str == 'K':
            ranks.append(13)
        elif rank_str == 'Q':
            ranks.append(12)
        elif rank_str == 'J':
            ranks.append(11)
        elif rank_str == 'T':
            ranks.append(10)
        else:
            ranks.append(int(rank_str))
            
    # Check for flush
    is_flush = len(set(suits)) == 1
    
    # Check for straight
    sorted_ranks = sorted(ranks, reverse=True)
    is_straight = False
    straight_high = 0
    if sorted_ranks == list(range(14, 9, -1)): # A, K, Q, J, T
        is_straight = True
        straight_high = 14
    elif sorted_ranks == [14, 5, 4, 3, 2]: # A, 5, 4, 3, 2 (wheel)
        is_straight = True
        straight_high = 5
    elif sorted_ranks == list(range(sorted_ranks[0], sorted_ranks[0]-5, -1)):
        is_straight = True
        straight_high = sorted_ranks[0]
        
    # Count ranks
    from collections import Counter
    rank_counts = Counter(ranks)
    counts = sorted(rank_counts.values(), reverse=True)
    # counts will be like [3, 2] for full house, [4, 1] for quads, etc.
    
    # Tie breakers for same category
    # We need to sort ranks by frequency, then by rank value descending.
    # Actually, standard way: sort by (-count, -rank)
    sorted_ranks_by_freq = sorted(ranks, key=lambda r: (-rank_counts[r], -r))
    
    if is_straight and is_flush:
        return (8, straight_high)
    elif counts[0] == 4:
        return (7, sorted_ranks_by_freq[0], sorted_ranks_by_freq[3], 
sorted_ranks_by_freq[4])
    elif counts[0] == 3 and counts[1] == 2:
        return (6, sorted_ranks_by_freq[0], sorted_ranks_by_freq[3])
    elif is_flush:
        return (5, sorted_ranks[0], sorted_ranks[1], sorted_ranks[2], 
sorted_ranks[3], sorted_ranks[4])
    elif is_straight:
        return (4, straight_high)
    elif counts[0] == 3:
        return (3, sorted_ranks_by_freq[0], sorted_ranks_by_freq[3], 
sorted_ranks_by_freq[4])
    elif counts[0] == 2 and counts[1] == 2:
        return (2, sorted_ranks_by_freq[0], sorted_ranks_by_freq[1], 
sorted_ranks_by_freq[4])
    elif counts[0] == 2:
        return (1, sorted_ranks_by_freq[0], sorted_ranks_by_freq[2], 
sorted_ranks_by_freq[3], sorted_ranks_by_freq[4])
    else:
        return (0, sorted_ranks[0], sorted_ranks[1], sorted_ranks[2], 
sorted_ranks[3], sorted_ranks[4])
```


    def right(self):
        if self.tree['right'] is None:
            return None
        return Zipper(self.tree['right'], self.path + [('right', self.tree)])

    def set_right(self, node):
        new_tree = dict(self.tree)
        new_tree['right'] = node
        return Zipper(new_tree, self.path)

    def up(self):
        if not self.path:
            return None
        direction, parent = self.path[-1]
        new_path = self.path[:-1]
        new_parent = dict(parent)
        new_parent[direction] = self.tree
        return Zipper(new_parent, new_path)

    def to_tree(self):
        if not self.path:
            return self.tree
        current = self.tree
        for direction, parent in reversed(self.path):
            new_parent = dict(parent)
            new_parent[direction] = current
            current = new_parent
        return current

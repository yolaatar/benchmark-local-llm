```python
def translate(text):
    def translate_word(word):
        if not word:
            return word
            
        # Rule 1: Starts with vowel, "xr", or "yt"
        if word[0] in 'aeiou' or word.startswith('xr') or word.startswith('yt'):
            return word + 'ay'
        
        # Find the split point for consonant clusters
        i = 0
        while i < len(word):
            char = word[i]
            if char in 'aeiou':
                # Rule 3: "qu" moves together
                if char == 'u' and i > 0 and word[i-1] == 'q':
                    i += 1
                    continue
                break
            # Rule 4: "y" after consonants acts as a vowel
            elif char == 'y' and i > 0:
                break
            i += 1
            
        # If no vowel-like character found, treat whole word as consonant cluster
        if i == len(word):
            return word + 'ay'
            
        # Rule 2 & 3 & 4: Move consonant cluster to end and add "ay"
        return word[i:] + word[:i] + 'ay'

    return ' '.join(translate_word(w) for w in text.split(' '))
```

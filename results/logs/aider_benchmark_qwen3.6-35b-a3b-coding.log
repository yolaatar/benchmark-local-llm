class StackUnderflowError(Exception):
    def __init__(self, message="Insufficient number of items in stack"):
        self.message = message
        super().__init__(self.message)


def evaluate(input_data):
    stack = []
    definitions = {}
    
    # Flatten input into tokens, lowercased
    tokens = []
    for line in input_data:
        tokens.extend(line.lower().split())
        
    i = 0
    while i < len(tokens):
        token = tokens[i]
        
        if token == ':':
            i += 1
            if i >= len(tokens):
                raise ValueError("undefined operation") # or similar
            name = tokens[i]
            i += 1
            def_tokens = []
            while i < len(tokens) and tokens[i] != ';':
                def_tokens.append(tokens[i])
                i += 1
            if i >= len(tokens):
                raise ValueError("undefined operation") # missing ;
            i += 1 # skip ';'
            definitions[name] = def_tokens
            
        elif token in definitions:
            # Expand definition
            # To avoid index issues, we can just process the definition tokens 
directly
            # But modifying `tokens` in place is easier if we adjust `i`
            # However, inserting into a list while iterating is O(N) and 
changes indices.
            # Let's use a different approach: use a list of tokens to process, 
and when we see a word,
            # we replace it with its tokens in the list? Actually, it's simpler
to just use a deque or just process recursively.
            # I'll stick to modifying `tokens` but carefully.
            # Actually, it's safer to just use a list `to_process` and iterate 
over it.
            # But `tokens` is already a list. I'll just use `tokens` and adjust
`i`.
            # `tokens[i:i] = definitions[token]`
            # `i += len(definitions[token]) - 1`
            # This works.
            tokens[i:i] = definitions[token]
            i += len(definitions[token]) - 1
            
        elif token == '+':
            if len(stack) < 2:
                raise StackUnderflowError()
            stack.append(stack.pop() + stack.pop())
        elif token == '-':
            if len(stack) < 2:
                raise StackUnderflowError()
            b, a = stack.pop(), stack.pop()
            stack.append(a - b)
        elif token == '*':
            if len(stack) < 2:
                raise StackUnderflowError()
            stack.append(stack.pop() * stack.pop())
        elif token == '/':
            if len(stack) < 2:
                raise StackUnderflowError()
            b, a = stack.pop(), stack.pop()
            if b == 0:
                raise ZeroDivisionError("divide by zero")
            stack.append(a // b)
        elif token == 'dup':
            if len(stack) < 1:
                raise StackUnderflowError()
            stack.append(stack[-1])
        elif token == 'drop':
            if len(stack) < 1:
                raise StackUnderflowError()
            stack.pop()
        elif token == 'swap':
            if len(stack) < 2:
                raise StackUnderflowError()
            stack[-1], stack[-2] = stack[-2], stack[-1]
        elif token == 'over':
            if len(stack) < 2:
                raise StackUnderflowError()
            stack.append(stack[-2])
        else:
            try:
                stack.append(int(token))
            except ValueError:
                raise ValueError("undefined operation")
                
        i += 1
        
    return stack
```


```python
class Zipper:
    def __init__(self, tree, path=None):
        self.tree = tree
        self.path = path or []

    @staticmethod
    def from_tree(tree):
        return Zipper(tree)

    def value(self):
        return self.tree['value']

    def set_value(self, val):
        new_tree = dict(self.tree)
        new_tree['value'] = val
        return Zipper(new_tree, self.path)

    def left(self):
        if self.tree['left'] is None:
            return None
        new_path = self.path + [('left', self.tree)]
        return Zipper(self.tree['left'], new_path)

    def set_left(self, node):
        new_tree = dict(self.tree)
        new_tree['left'] = node
        return Zipper(new_tree, self.path)

    def right(self):
        if self.tree['right'] is None:
            return None
        new_path = self.path + [('right', self.tree)]
        return Zipper(self.tree['right'], new_path)

    def set_right(self, node):
        new_tree = dict(self.tree)
        new_tree['right'] = node
        return Zipper(new_tree, self.path)

    def up(self):
        if not self.path:
            return None
        direction, parent = self.path[-1]
        new_path = self.path[:-1]
        # We need to reconstruct the parent with the current tree as the child 
in the correct direction
        new_parent = dict(parent)
        new_parent[direction] = self.tree
        return Zipper(new_parent, new_path)

    def to_tree(self):
        if not self.path:
            return self.tree
        # Reconstruct up to root
        current = self.tree
        for direction, parent in reversed(self.path):
            new_parent = dict(parent)
            new_parent[direction] = current
            current = new_parent
        return current
```


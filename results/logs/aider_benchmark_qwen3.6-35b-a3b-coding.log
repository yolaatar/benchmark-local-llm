```python
class BowlingGame:
    def __init__(self):
        self.rolls = []

    def roll(self, pins):
        if pins < 0:
            raise ValueError("Negative roll is invalid")
        if pins > 10:
            raise ValueError("Pin count exceeds pins on the lane")
            
        if self.is_game_over():
            raise ValueError("Cannot roll after game is over")
            
        # Validate frame pin count for regular frames
        if len(self.rolls) > 0:
            frame = 0
            idx = 0
            while frame < 9:
                if self.rolls[idx] == 10:
                    idx += 1
                else:
                    idx += 2
                frame += 1
            
            if idx == 8:
                # 10th frame, no additional pin limit check needed here as 
is_game_over handles it
                pass
            else:
                # Regular frame, second throw
                if self.rolls[idx-1] + pins > 10:
                    raise ValueError("Pin count exceeds pins on the lane")
                    
        self.rolls.append(pins)

    def is_game_over(self):
        rolls = self.rolls
        if len(rolls) == 0:
            return False
            
        frame = 0
        idx = 0
        while frame < 9:
            if rolls[idx] == 10:
                idx += 1
            else:
                if idx + 1 >= len(rolls):
                    return False
                if rolls[idx] + rolls[idx+1] > 10:
                    raise ValueError("Pin count exceeds pins on the lane")
                idx += 2
            frame += 1
            
        # 10th frame
        if len(rolls) < 2:
            return False
        if rolls[8] == 10: # Strike
            if len(rolls) < 11:
                return False
            if rolls[9] != 10 and rolls[9] + rolls[10] > 10:
                raise ValueError("Pin count exceeds pins on the lane")
        elif rolls[8] + rolls[9] == 10: # Spare
            if len(rolls) < 11:
                return False
        else: # Open
            if len(rolls) < 10:
                return False
                
        return True

    def score(self):
        if not self.is_game_over():
            raise ValueError("Score cannot be taken until the end of the game")
            
        score = 0
        idx = 0
        for frame in range(10):
            if frame == 9:
                score += sum(self.rolls[idx:])
                break
                
            if self.rolls[idx] == 10: # Strike
                score += 10 + self.rolls[idx+1] + self.rolls[idx+2]
                idx += 1
            elif self.rolls[idx] + self.rolls[idx+1] == 10: # Spare
                score += 10 + self.rolls[idx+2]
                idx += 2
            else: # Open
                score += self.rolls[idx] + self.rolls[idx+1]
                idx += 2
        return score
```


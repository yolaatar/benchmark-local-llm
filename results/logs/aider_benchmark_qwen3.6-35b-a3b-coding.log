                nb1, nb2 = state
                if nb1 == goal:
                    return (steps + 1, "one", nb2)
                if nb2 == goal:
                    return (steps + 1, "two", nb1)
                queue.append((state, steps + 1))
                
    raise ValueError("Goal not reachable")

            result.sort(key=lambda x: x["name"])
            return {"users": result}
        return None

    def post(self, url, payload=None):
        if url == "/add":
            data = json.loads(payload) if isinstance(payload, str) else (payload or {})
            name = data["user"]
            if name not in self.users:
                self.users[name] = {"name": name, "owes": {}, "owed_by": {}, "balance": 0}
            return {"user": self._format_user(self.users[name])}
        elif url == "/iou":
            data = json.loads(payload) if isinstance(payload, str) else (payload or {})

                    cell._value = new_val
                    changed = True
        
        for cell in affected:
            if old_values[cell] != cell.value:
                for cb in list(cell._callbacks):
                    cb(cell.value)


class ComputeCell:
    def __init__(self, inputs, compute_function):
        self._inputs = inputs
        self._compute_function = compute_function
        self._value = self._compute()
        self._dependents = []
        self._callbacks = []
        

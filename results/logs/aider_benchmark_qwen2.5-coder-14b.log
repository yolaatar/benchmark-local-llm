To implement the RESTful API for tracking IOUs, we need to:

1. Initialize the database in the `RestAPI` class.
2. Implement the `get` method to handle requests for user information.
3. Implement the `post` method to handle requests for adding users and creating IOUs.

Here is the updated `rest_api.py` file:

rest_api.py
```
class RestAPI:
    def __init__(self, database=None):
        self.database = database if database is not None else {}

    def get(self, url, payload=None):
        if url == "/users":
            if payload:
                users = payload.get("users", [])
                return {"users": [self.get_user(user) for user in users]}
            else:
                return {"users": [self.get_user(user) for user in self.database]}
        return {}

    def post(self, url, payload=None):
        if url == "/add":
            user = payload.get("user")
            if user not in self.database:
                self.database[user] = {"owes": {}, "owed_by": {}, "balance": 0.0}
                return self.get_user(user)
        elif url == "/iou":
            lender = payload.get("lender")
            borrower = payload.get("borrower")
            amount = payload.get("amount")
            if lender in self.database and borrower in self.database:
                self.database[lender]["owed_by"][borrower] = self.database[lender].get("owed_by", {}).get(borrower, 0) + amount
                self.database[borrower]["owes"][lender] = self.database[borrower].get("owes", {}).get(lender, 0) + amount
                self.database[lender]["balance"] += amount
                self.database[borrower]["balance"] -= amount
                return {"users": [self.get_user(lender), self.get_user(borrower)]}
        return {}

    def get_user(self, user):
        user_data = self.database[user]

The issue here is that the `encode` and `decode` functions are returning uppercase letters, but the tests expect lowercase letters. We need to ensure that the output is in lowercase.

Let's update the `encode` and `decode` functions to return lowercase letters.

affine_cipher.py
```
import string

def gcd(a, b):
    while b:
        a, b = b, a % b
    return a

def modular_inverse(a, m):
    m0, x0, x1 = m, 0, 1
    if m == 1:
        return 0
    while a > 1:
        # q is quotient
        q = a // m
        m, a = a % m, m
        x0, x1 = x1 - q * x0, x0
    # Make x1 positive
    if x1 < 0:
        x1 += m0
    return x1

def encode(plain_text, a, b):
    if gcd(a, 26) != 1:
        raise ValueError("a and m must be coprime.")
    
    plain_text = ''.join(filter(str.isalnum, plain_text)).upper()
    ciphered_text = []
    
    for char in plain_text:
        if char.isdigit():
            ciphered_text.append(char)
        else:
            i = string.ascii_uppercase.index(char)
            ciphered_text.append(string.ascii_lowercase[(a * i + b) % 26])
    
    # Group the ciphertext into blocks of 5 characters
    grouped_ciphered_text = ' '.join([''.join(ciphered_text[i:i+5]) for i in range(0, len(ciphered_text), 5)])
    return grouped_ciphered_text

def decode(ciphered_text, a, b):
    if gcd(a, 26) != 1:
        raise ValueError("a and m must be coprime.")
    
    a_inv = modular_inverse(a, 26)
    ciphered_text = ''.join(filter(str.isalnum, ciphered_text)).upper()
    plain_text = []
    
    for char in ciphered_text:
        if char.isdigit():
            plain_text.append(char)
        else:
            i = string.ascii_uppercase.index(char)
            plain_text.append(string.ascii_lowercase[(a_inv * (i - b)) % 26])
    
    return ''.join(plain_text)
```

This change ensures that the output of both `encode` and `decode` functions is in lowercase, which should resolve the test failures.

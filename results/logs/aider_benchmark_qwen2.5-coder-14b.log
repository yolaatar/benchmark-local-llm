import re

class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string or input_string != input_string.strip():
        raise ValueError("tree missing")
    if input_string[0] != '(' or input_string[-1] != ')':
        raise ValueError("tree missing")

    def parse_node(node_str):
        properties = {}
        property_pattern = re.compile(r'([A-Z]+)\[([^\]]*)\]')
        for key, value in property_pattern.findall(node_str):
            if key != key.upper():
                raise ValueError("property must be in uppercase")
            if key in properties:
                properties[key].append(value)
            else:
                properties[key] = [value]
        return SgfTree(properties)

    def parse_tree(tree_str):
        if not tree_str:
            raise ValueError("tree with no nodes")
        nodes = []
        current_node_str = ''
        depth = 0
        for char in tree_str:
            if char == '(':
                if depth == 0:
                    current_node_str = ''
                depth += 1
            elif char == ')':
                depth -= 1
                if depth == 0:
                    nodes.append(parse_node(current_node_str))
            if depth > 0:
                current_node_str += char
        if depth != 0:
            raise ValueError("tree missing")
        return nodes

    tree_str = input_string[1:-1]
    nodes = parse_tree(tree_str)
    if not nodes:
        raise ValueError("tree with no nodes")
    root = nodes[0]
    current_node = root
    for node in nodes[1:]:
        current_node.children.append(node)
        current_node = node
    return root
```


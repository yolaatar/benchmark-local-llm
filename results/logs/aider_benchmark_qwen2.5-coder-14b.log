Here is the updated `two_bucket.py` file:

two_bucket.py
```
from collections import deque

def gcd(a, b):
    while b:
        a, b = b, a % b
    return a

def measure(bucket_one, bucket_two, goal, start_bucket):
    if goal > max(bucket_one, bucket_two):
        raise ValueError("Goal cannot be greater than the size of the largest bucket.")
    if goal % gcd(bucket_one, bucket_two) != 0:
        raise ValueError("Goal cannot be measured with the given bucket sizes.")

    def pour(from_bucket, to_bucket, from_size, to_size):
        amount = min(from_bucket, to_size - to_bucket)
        return (from_bucket - amount, to_bucket + amount)

    def empty(bucket):
        return (0, bucket)

    def fill(bucket, size):
        return (size, bucket)

    start_state = (bucket_one if start_bucket == 'one' else 0, bucket_two if start_bucket == 'two' else 0)
    queue = deque([(start_state, 0, start_bucket)])
    visited = set()
    visited.add(start_state)

    while queue:
        (bucket1, bucket2), actions, last_action = queue.popleft()

        if bucket1 == goal or bucket2 == goal:
            return (actions, 'one' if bucket1 == goal else 'two', bucket2 if bucket1 == goal else bucket1)

        # Possible actions
        next_states = []

        # Pour bucket1 to bucket2
        if last_action != 'empty1' and last_action != 'fill2':
            next_state = pour(bucket1, bucket2, bucket_one, bucket_two)
            if next_state not in visited:
                visited.add(next_state)
                next_states.append((next_state, actions + 1, 'pour1to2'))

        # Pour bucket2 to bucket1
        if last_action != 'empty2' and last_action != 'fill1':
            next_state = pour(bucket2, bucket1, bucket_two, bucket_one)
            if next_state not in visited:
                visited.add(next_state)
                next_states.append((next_state, actions + 1, 'pour2to1'))

        # Empty bucket1
        if last_action != 'fill1':
            next_state = empty(bucket1)
            if next_state not in visited:
                visited.add(next_state)
                next_states.append((next_state, actions + 1, 'empty1'))

        # Empty bucket2
        if last_action != 'fill2':
            next_state = empty(bucket2)
            if next_state not in visited:
                visited.add(next_state)
                next_states.append((next_state, actions + 1, 'empty2'))

        # Fill bucket1
        if last_action != 'empty1':
            next_state = fill(bucket1, bucket_one)
            if next_state not in visited:
                visited.add(next_state)
                next_states.append((next_state, actions + 1, 'fill1'))

        # Fill bucket2
        if last_action != 'empty2':
            next_state = fill(bucket2, bucket_two)
            if next_state not in visited:
                visited.add(next_state)
                next_states.append((next_state, actions + 1, 'fill2'))

        queue.extend(next_states)
```

This change ensures that the `gcd` function is defined before it is used in the `measure` function.

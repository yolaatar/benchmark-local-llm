zipper.py
```
class TreeNode:
    def __init__(self, value, left=None, right=None):
        self.value = value
        self.left = left
        self.right = right

class Zipper:
    def __init__(self, tree, path=None):
        self.tree = tree
        self.path = path if path is not None else []

    @staticmethod
    def from_tree(tree):
        return Zipper(_dict_to_tree(tree))

    def to_tree(self):
        if not self.path:
            return _tree_to_dict(self.tree)
        else:
            return _tree_to_dict(self.path[-1][0])

    def value(self):
        return self.tree.value

    def set_value(self, value):
        new_tree = TreeNode(value, self.tree.left, self.tree.right)
        return Zipper(new_tree, self.path)

    def left(self):
        if self.tree.left is None:
            return None
        new_path = self.path + [(self.tree, 'left')]
        return Zipper(self.tree.left, new_path)

    def set_left(self, subtree):
        new_tree = TreeNode(self.tree.value, subtree, self.tree.right)
        return Zipper(new_tree, self.path)

    def right(self):
        if self.tree.right is None:
            return None
        new_path = self.path + [(self.tree, 'right')]
        return Zipper(self.tree.right, new_path)

    def set_right(self, subtree):
        new_tree = TreeNode(self.tree.value, self.tree.left, subtree)
        return Zipper(new_tree, self.path)

    def up(self):
        if not self.path:
            return None
        parent, direction = self.path[-1]
        return Zipper(parent, self.path[:-1])

    def insert_before(self, subtree):
        if not self.path:
            return None
        parent, direction = self.path[-1]
        if direction == 'left':
            new_parent = TreeNode(parent.value, subtree, parent.right)
        else:
            new_parent = TreeNode(parent.value, parent.left, subtree)
        return Zipper(new_parent, self.path[:-1])

    def insert_after(self, subtree):
        if not self.path:
            return None
        parent, direction = self.path[-1]
        if direction == 'left':
            new_parent = TreeNode(parent.value, parent.left, subtree)
        else:
            new_parent = TreeNode(parent.value, subtree, parent.right)
        return Zipper(new_parent, self.path[:-1])

    def delete(self):
        if not self.path:
            return None
        parent, direction = self.path[-1]
        if direction == 'left':
            new_parent = TreeNode(parent.value, None, parent.right)
        else:
            new_parent = TreeNode(parent.value, parent.left, None)
        return Zipper(new_parent, self.path[:-1])

def _dict_to_tree(d):
    if d is None:
        return None
    return TreeNode(d['value'], _dict_to_tree(d.get('left')), _dict_to_tree(d.get('right')))

def _tree_to_dict(node):
    if node is None:
        return None
    return {
        'value': node.value,
        'left': _tree_to_dict(node.left),
        'right': _tree_to_dict(node.right)
    }
```


    book_counts = {}
    for book in basket:
        if book in book_counts:
            book_counts[book] += 1
        else:
            book_counts[book] = 1
    
    total_cost = 0
    
    # Group books into sets to maximize discounts
    while book_counts:
        group = set()
        for book, count in list(book_counts.items()):
            if count > 0:
                group.add(book)
                book_counts[book] -= 1
                if book_counts[book] == 0:
                    del book_counts[book]
        
        # Calculate the cost for this group
        group_size = len(group)
        group_cost = group_size * book_price * (1 - discounts[group_size])
        total_cost += group_cost
    
    return total_cost
```


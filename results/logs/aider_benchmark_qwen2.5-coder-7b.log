import pytest
from react import InputCell, ComputeCell

class ReactTest:
    def test_callback_cells_only_fire_on_change(self):
        input = InputCell(1)
        output = ComputeCell([input], lambda inputs: 111 if inputs[0] < 3 else 222)
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        output.add_callback(callback)
        input.set_value(2)
        assert callback_called
        input.set_value(3)
        assert not callback_called

    def test_callbacks_can_be_added_and_removed(self):
        input = InputCell(11)
        output = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        output.add_callback(callback)
        input.set_value(12)
        assert callback_called
        output.remove_callback(callback)
        input.set_value(13)
        assert not callback_called

    def test_callbacks_can_fire_from_multiple_cells(self):
        input = InputCell(1)
        plus_one = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        plus_two = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 2,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        plus_one.add_callback(callback)
        plus_two.add_callback(callback)
        input.set_value(2)
        assert callback_called
        input.set_value(3)
        assert callback_called

    def test_callbacks_do_not_report_already_reported_values(self):
        input = InputCell(1)
        output = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        output.add_callback(callback)
        input.set_value(2)
        assert callback_called
        input.set_value(2)
        assert not callback_called

    def test_callbacks_should_not_be_called_if_dependencies_change_but_output_value_doesn_t_change(self):
        input = InputCell(1)
        plus_one = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        plus_one.add_callback(callback)
        input.set_value(2)
        assert callback_called
        input.set_value(2)
        assert not callback_called

    def test_callbacks_should_only_be_called_once_even_if_multiple_dependencies_change(self):
        input = InputCell(1)
        plus_one = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        plus_one.add_callback(callback)
        input.set_value(2)
        assert callback_called
        input.set_value(3)
        assert callback_called

    def test_compute_cells_calculate_initial_value(self):
        input = InputCell(1)
        output = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        assert output.value == 2

    def test_compute_cells_can_depend_on_other_compute_cells(self):
        input = InputCell(1)
        times_two = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] * 2,
        )
        plus_one = ComputeCell(
            [
                times_two,
            ],
            lambda inputs: inputs[0] + 1,
        )
        assert plus_one.value == 3

    def test_compute_cells_fire_callbacks(self):
        input = InputCell(1)
        output = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        output.add_callback(callback)
        input.set_value(2)
        assert callback_called

    def test_compute_cells_take_inputs_in_the_right_order(self):
        one = InputCell(1)
        two = InputCell(2)
        output = ComputeCell(
            [
                one,
                two,
            ],
            lambda inputs: inputs[0] + inputs[1] * 10,
        )
        assert output.value == 21

    def test_compute_cells_update_value_when_dependencies_are_changed(self):
        input = InputCell(1)
        output = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        assert output.value == 2
        input.set_value(2)
        assert output.value == 3

    def test_removing_a_callback_multiple_times_doesn_t_interfere_with_other_callbacks(self):
        input = InputCell(1)
        output = ComputeCell(
            [
                input,
            ],
            lambda inputs: inputs[0] + 1,
        )
        callback_called = False

        def callback():
            nonlocal callback_called
            callback_called = True

        output.add_callback(callback)
        output.remove_callback(callback)
        output.remove_callback(callback)  # This should not cause an error
        input.set_value(2)
        assert not callback_called
```


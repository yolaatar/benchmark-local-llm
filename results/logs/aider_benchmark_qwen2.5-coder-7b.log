def measure(bucket_one, bucket_two, goal, start_bucket):
    if bucket_one <= 0 or bucket_two <= 0 or goal <= 0:
        raise ValueError("Bucket sizes and goal must be greater than zero.")
    if bucket_one == goal or bucket_two == goal:
        return 0, start_bucket, 0 if start_bucket == 1 else bucket_two
    if start_bucket == 1:
        current_bucket = bucket_one
        other_bucket = bucket_two
    else:
        current_bucket = bucket_two
        other_bucket = bucket_one

    actions = 0

    while True:
        if current_bucket == goal:
            return actions, start_bucket, other_bucket
        if other_bucket == current_bucket + other_bucket:
            other_bucket = current_bucket
            actions += 1
        elif other_bucket == bucket_two:
            current_bucket -= other_bucket
            other_bucket = 0
            actions += 1
        elif current_bucket == bucket_one:
            other_bucket += current_bucket
            current_bucket = 0
            actions += 1
        else:
            if other_bucket + current_bucket <= bucket_two:
                other_bucket += current_bucket
                current_bucket = 0
            else:
                current_bucket -= bucket_two - other_bucket
                other_bucket = bucket_two
            actions += 1
```


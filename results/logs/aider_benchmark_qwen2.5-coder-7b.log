To implement the SGF parser, we need to:

1. Parse the input string to extract nodes and properties.
2. Handle variations and multiple values for properties.
3. Raise appropriate `ValueError` exceptions with meaningful messages if the input is invalid.

Here is the updated `sgf_parsing.py` file:

sgf_parsing.py
```
class SgfTree:
    def __init__(self, properties=None, children=None):
        self.properties = properties or {}
        self.children = children or []

    def __eq__(self, other):
        if not isinstance(other, SgfTree):
            return False
        for key, value in self.properties.items():
            if key not in other.properties:
                return False
            if other.properties[key] != value:
                return False
        for key in other.properties.keys():
            if key not in self.properties:
                return False
        if len(self.children) != len(other.children):
            return False
        for child, other_child in zip(self.children, other.children):
            if child != other_child:
                return False
        return True

    def __ne__(self, other):
        return not self == other


def parse(input_string):
    if not input_string:
        raise ValueError("tree missing")

    if input_string[0] != '(' or input_string[-1] != ')':
        raise ValueError("tree missing")

    input_string = input_string[1:-1].strip()

    if not input_string:
        raise ValueError("tree with no nodes")

    def parse_node(node_string):
        properties = {}
        children = []
        i = 0
        while i < len(node_string):
            if node_string[i] == '(':
                j = node_string.find(')', i)
                if j == -1:
                    raise ValueError("properties without delimiter")
                child_string = node_string[i:j+1]
                children.append(parse_node(child_string))
                i = j + 1
            elif node_string[i] == ';':
                i += 1
                key = ''
                value = ''
                while i < len(node_string) and node_string[i] != '[':
                    key += node_string[i]
                    i += 1
                if key.isupper():
                    while i < len(node_string) and node_string[i] != ']':
                        if node_string[i] == '\\':
                            i += 1
                            if i < len(node_string):
                                value += node_string[i]
                        else:
                            value += node_string[i]
                        i += 1
                    if key not in properties:
                        properties[key] = []
                    properties[key].append(value)
                else:
                    raise ValueError("property must be in uppercase")
            else:
                raise ValueError("tree missing")
        return SgfTree(properties, children)

    return parse_node(input_string)
```

This implementation includes:
1. Handling of the top-level node and its children.
2. Parsing of properties and their values, including handling of escape sequences.
3. Raising appropriate `ValueError` exceptions with meaningful messages for various error conditions.

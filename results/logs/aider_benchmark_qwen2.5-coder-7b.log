To implement the RESTful API for tracking IOUs, we need to:

1. Initialize a database to store user information.
2. Implement the `get` method to handle GET requests.
3. Implement the `post` method to handle POST requests.

Here is the updated `rest_api.py` file:

rest_api.py
```
class RestAPI:
    def __init__(self, database=None):
        if database is None:
            database = {}
        self.database = database

    def get(self, url, payload=None):
        if url == '/users':
            if payload and 'users' in payload:
                users = payload['users']
                return {'users': sorted([self.database.get(user, {}) for user in users], key=lambda x: x.get('name', ''))}
            else:
                return {'users': sorted(self.database.values(), key=lambda x: x.get('name', ''))}
        return {'error': 'Invalid URL'}

    def post(self, url, payload=None):
        if url == '/add':
            if payload and 'user' in payload:
                user = payload['user']
                if user not in self.database:
                    self.database[user] = {
                        'name': user,
                        'owes': {},
                        'owed_by': {},
                        'balance': 0.0
                    }
                    return self.database[user]
                else:
                    return {'error': 'User already exists'}
            else:
                return {'error': 'Invalid payload'}
        elif url == '/iou':
            if payload and 'lender' in payload and 'borrower' in payload and 'amount' in payload:
                lender = payload['lender']
                borrower = payload['borrower']
                amount = payload['amount']
                if lender in self.database and borrower in self.database:
                    if borrower not in self.database[lender]['owes']:
                        self.database[lender]['owes'][borrower] = 0.0
                    self.database[lender]['owes'][borrower] += amount
                    if lender not in self.database[borrower]['owed_by']:
                        self.database[borrower]['owed_by'][lender] = 0.0
                    self.database[borrower]['owed_by'][lender] -= amount
                    self.database[lender]['balance'] += amount
                    self.database[borrower]['balance'] -= amount
                    return {'users': sorted([self.database[lender], self.database[borrower]], key=lambda x: x.get('name', ''))}
                else:
                    return {'error': 'User not found'}
            else:
                return {'error': 'Invalid payload'}
        return {'error': 'Invalid URL'}
```

This implementation includes:
1. An `__init__` method to initialize the database.
2. A `get` method to handle GET requests for listing users.
3. A `post` method to handle POST requests for adding users and creating IOUs.
